Z2M_PORT=8080
TZ=Europe/Berlin
# Host path of your Zigbee USB adapter (see /dev/serial/by-id/ on the host)
ZIGBEE_DEVICE=/dev/ttyACM0
# MQTT broker address (host name or IP of your broker)
MQTT_SERVER=mqtt://192.168.1.10:1883
# Uncomment if the broker requires a login:
#ZIGBEE2MQTT_CONFIG_MQTT_USER=
#ZIGBEE2MQTT_CONFIG_MQTT_PASSWORD=

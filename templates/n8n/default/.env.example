N8N_PORT=5678
GENERIC_TIMEZONE=Europe/Berlin
# Encrypts stored credentials - set a long random value (e.g. openssl rand -hex 32) before first start
N8N_ENCRYPTION_KEY=changeme
# Set to true when n8n is served over HTTPS (e.g. behind a reverse proxy)
N8N_SECURE_COOKIE=false
# Public URL n8n is reached at (needed for webhooks / OAuth callbacks behind a reverse proxy), e.g. https://n8n.example.com/
#WEBHOOK_URL=

# Service wiring - normally no need to change
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

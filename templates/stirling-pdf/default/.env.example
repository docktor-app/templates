APP_PORT=8080
# Login is enabled by default. These credentials create the first admin
# account; you are asked to change the password after the first login.
SECURITY_ENABLELOGIN=true
SECURITY_INITIALLOGIN_USERNAME=admin
SECURITY_INITIALLOGIN_PASSWORD=changeme
# Default UI language for new users (e.g. en-US, en-GB, de-DE)
SYSTEM_DEFAULTLOCALE=en-US
